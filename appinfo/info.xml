<?xml version="1.0" encoding="utf-8"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>verein</id>
    <name>Verein</name>
    <summary>Vereinsmanagement Dashboard</summary>
    <description><![CDATA[
A comprehensive club/association management solution for Nextcloud with member management, fee tracking, SEPA export, and dashboard integration.
    ]]></description>
    <version>0.16.1-beta</version>
    <licence>agpl</licence>
    <author>Vereinsverwaltung</author>
    <namespace>Verein</namespace>
    <category>organization</category>
    <category>tools</category>
    <website>https://github.com/ghostsailorgit/nextcloud-vereinsverwaltung</website>
    <bugs>https://github.com/ghostsailorgit/nextcloud-vereinsverwaltung/issues</bugs>
    <repository type="git">https://github.com/ghostsailorgit/nextcloud-vereinsverwaltung.git</repository>
    <dependencies>
        <php min-version="8.1" max-version="8.5"/>
        <nextcloud min-version="27" max-version="34"/>
    </dependencies>
    <navigations>
        <navigation>
            <id>verein</id>
            <name>Verein</name>
            <route>verein.page.index</route>
            <icon>app.svg</icon>
            <order>10</order>
        </navigation>
    </navigations>

    <background-jobs>
        <job>OCA\Verein\BackgroundJob\DailyBackupJob</job>
        <job>OCA\Verein\BackgroundJob\AuditLogCleanupJob</job>
    </background-jobs>

    <commands>
        <command>OCA\Verein\Command\ListBackups</command>
        <command>OCA\Verein\Command\RestoreBackup</command>
    </commands>

</info>
