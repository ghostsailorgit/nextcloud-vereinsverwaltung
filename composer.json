{
    "name": "ghostsailorgit/nextcloud-vereinsverwaltung",
    "description": "Nextcloud app for club/association management",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Vereinsverwaltung contributors"
        }
    ],
    "require": {
        "php": ">=8.1",
        "tecnickcom/tcpdf": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nextcloud/coding-standard": "^1.0",
        "nextcloud/ocp": "dev-master",
        "doctrine/dbal": "^4"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Verein\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Verein\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
